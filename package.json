{
  "name": "producer-tools",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm --filter @shadowroom/web dev",
    "build": "pnpm --filter @shadowroom/web build",
    "preview": "pnpm --filter @shadowroom/web preview",
    "serve": "node tools/mcp-bridge.mjs",
    "serve:agent": "node tools/agent-bridge.mjs",
    "mcp:config": "node tools/print-mcp-config.mjs",
    "mcp:bootstrap": "node tools/bootstrap-ecosystem.mjs",
    "typecheck": "pnpm --filter @shadowroom/web typecheck",
    "test": "pnpm --filter @shadowroom/web test"
  }
}
